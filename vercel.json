{
  "version": 2,
  "buildCommand": "cd frontend && npm run build && mv dist ../dist",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://stegx-03ut.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://stegx-03ut.onrender.com/uploads/$1" },
    { "source": "/outputs/(.*)", "destination": "https://stegx-03ut.onrender.com/outputs/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
